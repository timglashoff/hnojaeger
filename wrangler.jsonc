{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hnojaeger",
  "compatibility_date": "2026-09-17",

  // Das Konto steht hier fest, nicht nur in der lokalen Wrangler-Anmeldung:
  // Wer in mehreren Cloudflare-Konten angemeldet ist, deployt sonst dorthin,
  // wo der Token gerade haengt — bei einer Arztseite der teuerste Fehler.
  // Passt die ID nicht zum angemeldeten Konto, bricht wrangler ab, statt
  // still einen zweiten Worker anzulegen.
  "account_id": "3a73d9fc0be017b56baa90d27b702b00",

  // Der Build steht hier und nicht im Cloudflare-Dashboard: Eine Einstellung
  // im Dashboard haengt am Konto und ist beim Umzug nicht mitgekommen - der
  // erste Build im neuen Konto lief ohne "npm run build" los und fand kein
  // ./dist. Im Repo reist die Angabe mit. scnnorddoerfer haelt es genauso.
  // Dafuer muss der Build-Befehl in den Workers Builds leer bleiben, sonst
  // baut die CI zweimal.
  "build": {
    "command": "npm run build",
    "watch_dir": "src"
  },

  // Reines Static-Asset-Deployment: kein Worker-Script noetig.
  // "auto-trailing-slash" passt zu trailingSlash: 'always' und
  // build.format: 'directory' in astro.config.mjs.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
